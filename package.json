{
  "name": "data-collection",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "智能数据采集与结构化工具（TypeScript 版）：自有抓取层 + LLM API 语义提取 + SQLite 落库 + Web 控制台",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "run-once": "node scripts/run-once.ts",
    "run-daemon": "node scripts/run-daemon.ts",
    "export": "node scripts/export-data.ts",
    "import-sources": "node scripts/import-sources.ts",
    "webapp": "node scripts/webapp.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@mozilla/readability": "^0.6.0",
    "express": "^4.21.2",
    "linkedom": "^0.18.13",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  }
}